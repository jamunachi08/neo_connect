  "endpoint": {
    "endpoint_title": "Magento (PowerTire) - Sales Invoice",
    "slug": "magento-sales-invoice",
    "direction": "Inbound",
    "reference_doctype": "Sales Invoice",
    "description": "Magento order JSON (Klever Tech spec 2026-09-15) -> Sales Invoice for PowerTire. Customer found/created by e-mail; vehicle + mobile written to the Customer; branch (installer) and sales rep kept as Magento sends them; payment recorded in the invoice Payments table (Tap / Tamara / Tabby / Cash). Invoices are saved as DRAFT until you switch Document Action to Submit at go-live.",
    "records_path": null,
    "external_id_path": "order_number",
    "on_duplicate": "Skip",
    "max_records_per_request": 50,
    "document_action": "Save as Draft",
    "process_async": 0,
    "ignore_permissions": 0,
    "row_filters": null,
    "pre_process_hook": "neo_connect.handlers.commerce.ensure_customer\nneo_connect.handlers.commerce.apply_charges\nneo_connect.handlers.commerce.add_invoice_payments",
    "post_process_hook": "neo_connect.handlers.commerce.check_grand_total",
    "outbound_source": "DocType Query",
    "server_method": null,
    "base_filters": null,
    "allowed_filters": null,
    "order_by": "modified asc",
    "default_page_length": 50,
    "max_page_length": 500,
    "defaults": {
      "taxes_and_charges": "{{company.default_sales_tax_template}}",
      "set_posting_time": 1,
      "disable_rounded_total": 1,
      "update_stock": 0,
      "items.warehouse": "{{company.default_warehouse}}",
      "cost_center": "{{company.cost_center}}"
    },
    "handler_settings": {
      "customer_email_path": "customer.email",
      "customer_name_paths": [
        "customer.firstname"
      ],
      "customer_phone_path": "billing_address.telephone",
      "billing_address_path": "billing_address",
      "address_map": {
        "line1": "street",
        "city": "city",
        "state": "region",
        "pincode": "postcode",
        "country_code": "country_id"
      },
      "items_path": "items",
      "shipping_amount_path": "totals.shipping_amount",
      "discount_amount_path": "totals.discount_amount",
      "discount_on": "Net Total",
      "grand_total_path": "totals.grand_total",
      "payment_method_path": "payment.method",
      "paid_amount_path": "payment.amount_paid",
      "payment_reference_path": "payment.transaction_id",
      "update_customer_fields": 1,
      "mode_of_payment_map": {
        "tap": "Tap",
        "tamara": "Tamara",
        "tabby": "Tabby",
        "cashondelivery": "Cash"
      },
      "customer_fields": {
        "custom_car_details__صفات_السيارة": "vehicle.make",
        "custom_year__سنة_الصنع": "vehicle.year",
        "custom_model__موديل_السيارة": "vehicle.model",
        "custom_plate_number__رقم_اللوحة": "vehicle.plate",
        "custom_mobile_no__رقم_الجوال_": "billing_address.telephone",
        "custom_vehicle_vin_number": "vehicle.vin_number"
      }
    },
    "field_maps": [
      {
        "external_path": "order_number",
        "erp_field": "po_no",
        "transform": "Text",
        "required": 1,
        "if_not_found": "Error",
        "notes": "Unique order id: duplicates are detected with it"
      },
      {
        "external_path": "order_date",
        "erp_field": "posting_date",
        "transform": "Date",
        "required": 1,
        "if_not_found": "Error",
        "notes": "Order date"
      },
      {
        "external_path": "order_date",
        "erp_field": "posting_time",
        "transform": "Time",
        "if_not_found": "Error"
      },
      {
        "external_path": "order_date",
        "erp_field": "po_date",
        "transform": "Date",
        "if_not_found": "Error"
      },
      {
        "external_path": "totals.order_currency_code",
        "erp_field": "currency",
        "transform": "Upper",
        "if_not_found": "Error"
      },
      {
        "external_path": "items[].sku",
        "erp_field": "items.item_code",
        "transform": "Lookup",
        "required": 1,
        "lookup_doctype": "Item",
        "lookup_field": "item_code",
        "if_not_found": "Error",
        "notes": "Must equal the ERPNext Item Code"
      },
      {
        "external_path": "items[].qty_ordered",
        "erp_field": "items.qty",
        "transform": "Float",
        "required": 1,
        "if_not_found": "Error"
      },
      {
        "external_path": "items[].price",
        "erp_field": "items.rate",
        "transform": "Float",
        "required": 1,
        "if_not_found": "Error",
        "notes": "Unit price excluding VAT"
      },
      {
        "external_path": "payment.method",
        "erp_field": "custom_طريقة_الدفع",
        "transform": "Value Map",
        "if_not_found": "Error",
        "value_map": {
          "tap": "تاب",
          "tamara": "تمارا",
          "cashondelivery": "نقدي",
          "tabby": "تابي",
          "*": "نقدي"
        },
        "notes": "Matches طريقة الدفع - no option for: tabby"
      },
      {
        "external_path": "installer.name",
        "erp_field": "custom_fitting_location__موقع_التركيب",
        "transform": "Expression",
        "if_not_found": "Error",
        "add_missing_option": 1,
        "expression": "first_of(record, 'installer.name', 'fulfillment.method')",
        "notes": "Kept as sent; if empty: fulfillment.method"
      },
      {
        "external_path": "erp_executive_code",
        "erp_field": "custom_اسم_مندوب_المبيعات",
        "transform": "None",
        "if_not_found": "Error",
        "add_missing_option": 1,
        "notes": "Kept as sent"
      },
      {
        "external_path": "customer.email",
        "erp_field": "contact_email",
        "transform": "Lower",
        "if_not_found": "Error",
        "notes": "Customer is found by e-mail or created"
      },
      {
        "external_path": "fulfillment.method",
        "erp_field": "custom_fulfillment_method",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_fulfillment_method on Sales Invoice"
      },
      {
        "external_path": "fulfillment.pickup_date",
        "erp_field": "custom_fulfillment_pickup_date",
        "transform": "Date",
        "if_not_found": "Error",
        "notes": "Created Date field custom_fulfillment_pickup_date on Sales Invoice"
      },
      {
        "external_path": "fulfillment.pickup_time",
        "erp_field": "custom_fulfillment_pickup_time",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_fulfillment_pickup_time on Sales Invoice"
      },
      {
        "external_path": "items[].brand",
        "erp_field": "items.custom_brand",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_brand on Sales Invoice Item"
      },
      {
        "external_path": "items[].width",
        "erp_field": "items.custom_width",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_width on Sales Invoice Item"
      },
      {
        "external_path": "items[].height",
        "erp_field": "items.custom_height",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_height on Sales Invoice Item"
      },
      {
        "external_path": "items[].rim",
        "erp_field": "items.custom_rim",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_rim on Sales Invoice Item"
      },
      {
        "external_path": "items[].speed_index",
        "erp_field": "items.custom_speed_index",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Data field custom_speed_index on Sales Invoice Item"
      },
      {
        "external_path": "fulfillment.delivery_date",
        "erp_field": "custom_fulfillment_delivery_date",
        "transform": "Date",
        "if_not_found": "Error",
        "notes": "Created Date field custom_fulfillment_delivery_date on Sales Invoice"
      },
      {
        "external_path": "fulfillment.delivery_comment",
        "erp_field": "custom_fulfillment_delivery_comment",
        "transform": "Text",
        "if_not_found": "Error",
        "notes": "Created Small Text field custom_fulfillment_delivery_comment on Sales Invoice"
      }
    ]
  },
